from collections import defaultdict
n,k=map(int,input().split())
arr=list(map(int,input().split()))
l=0
check=defaultdict(int)
unique=set()
counter=0

for r in range(n):
    check[arr[r]]+=1
    while len(check)>k:
        check[arr[l]]-=1
        if check[arr[l]]==0:
            del check[arr[l]]
        l+=1
    counter+=(r-l+1)
print(counter)
   
    
