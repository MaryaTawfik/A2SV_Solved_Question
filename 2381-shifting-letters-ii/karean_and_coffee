n,k,q=map(int,input().split())
ranges=[0]*(200000+2)
for i in range (n):
   
    row,col=map(int,input().split())
    ranges[row]+=1
    ranges[col+1]-=1
for i in range(1,len(ranges)):
    ranges[i]+=ranges[i-1]
valid=[0]*(200000+2)
for i in range(len(valid)):
    if ranges[i]>=k:
        valid[i]=1
for i in range(1,len(ranges)):
    valid[i]+=valid[i-1]
for i in range(q):
    a,b=map(int,input().split())
    print(valid[b]-valid[a-1])
